# Used by docker-compose.yml. Copy to .env and change the secrets.
DB_USERNAME=skillbridge
DB_PASSWORD=change-me
# 32+ characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=
# Demo accounts (admin@skillbridge.com / admin123 ...) are created on an empty database.
# Set to false for anything beyond local development.
SEED_DATA=true
